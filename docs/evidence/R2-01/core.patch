+from dataclasses import dataclass
+from datetime import datetime
+from uuid import UUID
+
+
+class OrderError(Exception):
+    """Public error with a stable code and a message suitable for the caller."""
+
+    def __init__(self, code: str, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+@dataclass(frozen=True)
+class Principal:
+    """User ID supplied by a trusted server-side authentication adapter."""
+
+    user_id: str
+
+
+@dataclass(frozen=True)
+class Order:
+    id: UUID
+    owner_id: str
+    service_id: str
+    service_name_snapshot: str
+    quantity: int
+    note: str
+    status: str
+    version: int
+    created_at: datetime
+    updated_at: datetime
+
+
+@dataclass(frozen=True)
+class Event:
+    sequence: int
+    from_status: str | None
+    to_status: str
+    actor_id: str
+    occurred_at: datetime
+
+
+@dataclass(frozen=True)
+class OrderDetail:
+    order: Order
+    history: tuple[Event, ...]
diff --git a/src/orderflow/repository.py b/src/orderflow/repository.py
new file mode 100644
--- /dev/null
+++ b/src/orderflow/repository.py
@@ -0,0 +1,122 @@
+"""Parameterized statements. The caller owns the transaction."""
+
+from uuid import UUID, uuid4
+
+from sqlalchemy import text
+from sqlalchemy.engine import Connection
+
+from .models import Event, Order, OrderDetail, OrderError
+
+
+def active_role(db: Connection, user_id: str) -> str | None:
+    return db.execute(
+        text("SELECT role FROM users WHERE id = :id AND active FOR SHARE"),
+        {"id": user_id},
+    ).scalar_one_or_none()
+
+
+def create(db: Connection, owner_id: str, service_id: str, quantity: int, note: str) -> Order:
+    service_name = db.execute(
+        text("SELECT name FROM service_catalogue WHERE id = :id AND active FOR SHARE"),
+        {"id": service_id},
+    ).scalar_one_or_none()
+    if service_name is None:
+        raise OrderError("INVALID_INPUT", "Select an available catalogue service.")
+    row = (
+        db.execute(
+            text("""
+            INSERT INTO orders
+                (id, owner_id, service_id, service_name_snapshot, quantity, note, created_at, updated_at)
+            VALUES (:id, :owner, :service, :name, :quantity, :note, statement_timestamp(),
+                    statement_timestamp())
+            RETURNING *
+        """),
+            {
+                "id": uuid4(),
+                "owner": owner_id,
+                "service": service_id,
+                "name": service_name,
+                "quantity": quantity,
+                "note": note,
+            },
+        )
+        .mappings()
+        .one()
+    )
+    return Order(**row)
+
+
+def append_event(db: Connection, order: Order, previous: str | None, actor_id: str) -> None:
+    db.execute(
+        text("""
+            INSERT INTO order_history (order_id, sequence, from_status, to_status, actor_id, occurred_at)
+            VALUES (:id, :version, :previous, :status, :actor, :occurred)
+        """),
+        {
+            "id": order.id,
+            "version": order.version,
+            "previous": previous,
+            "status": order.status,
+            "actor": actor_id,
+            "occurred": order.updated_at,
+        },
+    )
+
+
+def not_found() -> OrderError:
+    return OrderError("NOT_FOUND", "No accessible order was found.")
+
+
+def list_visible(db: Connection, owner_id: str | None) -> list[Order]:
+    scope = "" if owner_id is None else "WHERE o.owner_id = :owner"
+    sql = f"SELECT o.* FROM orders o {scope} ORDER BY o.created_at DESC, o.id"
+    rows = db.execute(text(sql), {"owner": owner_id}).mappings()
+    return [Order(**row) for row in rows]
+
+
+def detail(db: Connection, order_id: UUID, owner_id: str | None) -> OrderDetail:
+    scope = "" if owner_id is None else "AND o.owner_id = :owner"
+    rows = (
+        db.execute(
+            text(f"""
+            SELECT o.*, h.sequence, h.from_status, h.to_status, h.actor_id, h.occurred_at
+            FROM orders o JOIN order_history h ON h.order_id = o.id
+            WHERE o.id = :id {scope} ORDER BY h.sequence
+        """),
+            {"id": order_id, "owner": owner_id},
+        )
+        .mappings()
+        .all()
+    )
+    if not rows:
+        raise not_found()
+    order = Order(**{key: rows[0][key] for key in Order.__dataclass_fields__})
+    history = tuple(Event(**{key: row[key] for key in Event.__dataclass_fields__}) for row in rows)
+    return OrderDetail(order, history)
+
+
+def lock_order(db: Connection, order_id: UUID) -> Order:
+    row = (
+        db.execute(text("SELECT * FROM orders WHERE id = :id FOR UPDATE"), {"id": order_id})
+        .mappings()
+        .one_or_none()
+    )
+    if row is None:
+        raise not_found()
+    return Order(**row)
+
+
+def advance(db: Connection, order_id: UUID, target: str) -> Order:
+    row = (
+        db.execute(
+            text("""
+            UPDATE orders SET status = :target, version = version + 1,
+                updated_at = GREATEST(clock_timestamp(), updated_at)
+            WHERE id = :id RETURNING *
+        """),
+            {"target": target, "id": order_id},
+        )
+        .mappings()
+        .one()
+    )
+    return Order(**row)
diff --git a/src/orderflow/rules.py b/src/orderflow/rules.py
new file mode 100644
